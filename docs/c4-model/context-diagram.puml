@startuml Amir-System-Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Amir System Context Diagram — AI Agent Orchestration Control Plane

' ──────────────────────────────────────────────────────────────────
' ACTORS
' ──────────────────────────────────────────────────────────────────

Person(developer, "Developer", "Creates tasks programmatically via API, monitors execution progress, debugs agent output")
Person(platform_operator, "Platform Operator", "Manages team/agent/workflow definitions, monitors system health, cost, and agent performance")
Person(approver, "Approver / Reviewer", "Grants human approvals (workflow gates, coercion), resolves escalation signals")
Person(agent_owner, "Agent Owner", "Registers and configures agent adapters, declares capabilities and output modes")
Person(security_officer, "Security Officer", "Enforces sandbox policy, network allowlists, secret injection, attestation verification")
Person(financial_controller, "Financial Controller", "Defines budget caps (team/tenant/org), monitors cost tracking and enforcements")
Person(compliance_officer, "Compliance Officer", "Audits linear hash-chained events, verifies tamper-evidence, reviews retention policies")
Person(project_manager, "Project Manager", "Tracks workflow progress, monitors feature delivery and compensation status")
Person(debugger, "On-call / Debugger", "Inspects agent sessions, replays failed executions for debugging")

' ──────────────────────────────────────────────────────────────────
' AMIR SYSTEM
' ──────────────────────────────────────────────────────────────────

System(amir, "Amir Control Plane", "Governance and orchestration platform that coordinates external AI agents through controlled execution workflows, policy enforcement, artifact validation, and auditability")

' ──────────────────────────────────────────────────────────────────
' EXTERNAL SYSTEMS
' ──────────────────────────────────────────────────────────────────

System_Ext(git_vcs, "Git VCS (GitHub/GitLab)", "Dual-purpose: (1) amir-config/ GitOps definitions (agents, roles, workflows, contracts, allowlists) and (2) source code repos cloned per workspace with durable effects (branches, PRs, commits) as compensation targets")
System_Ext(ci_cd, "CI/CD Pipeline", "Validates workflow artifacts (PRs, code changes); config validation (JSON Schema, DDL); separate system triggered by Amir PRs")
System_Ext(llm_providers, "LLM Providers", "OpenAI, Anthropic, Google, etc. — external API endpoints agents call through Amir's egress proxy for inference")
System_Ext(vault, "HashiCorp Vault / KMS", "Secret storage for JIT injection via SecretBinding with TTL; signing keys for sandbox attestation and linear hash-chain audit root-commit")
System_Ext(prometheus, "Prometheus / OpenTelemetry", "Metrics collection (cost records, agent performance, validation pipeline); distributed tracing via W3C trace context")
System_Ext(object_storage, "Object Storage (WORM)", "Permanent audit log retention (linear hash-chained events), replay metadata, large artifact storage, transparency log root-commits")
System_Ext(notification_system, "Notification System", "Delivers EscalationSignals to assigned recipients (cost_limit_exceeded, compensation_blocked, input_timeout); approval request routing")
System_Ext(registries, "Package & Container Registries", "PyPI, npm, ghcr.io, quay.io — agent dependency installs (coding_standard profile) and sandbox image pulls (container_build profile only)")
System_Ext(message_queue, "Message Queue (optional)", "Kafka / NATS — high-throughput domain event publishing (alternative to outbox table)")
System_Ext(transparency_log, "Transparency Log (optional)", "Append-only log (Sigstore/Rekor) for periodic root-commit of audit hash-chain tips")
System_Ext(idp, "Identity Provider", "Issues JWTs / OAuth tokens for API access and service-to-service mTLS authentication")

System_Ext(agents, "External AI Agents", "Claude Code CLI, Codex, OpenCode, Gemini CLI, MCP servers, API agents — heterogeneous, non-deterministic, untrusted")

' ──────────────────────────────────────────────────────────────────
' RELATIONSHIPS — ACTORS → AMIR
' ──────────────────────────────────────────────────────────────────

Rel(developer, amir, "Creates tasks, monitors execution, debugs agent output", "REST API")
Rel(platform_operator, amir, "Manages definitions, monitors metrics/cost/health, configures teams", "REST API")
Rel(approver, amir, "Grants approvals (workflow gates, coercion), resolves escalation signals", "REST API")
Rel(agent_owner, amir, "Registers agent adapters, declares capabilities, configures output modes", "REST API")
Rel(security_officer, amir, "Defines sandbox policies, network allowlists, secret bindings, attestation rules", "REST API")
Rel(financial_controller, amir, "Defines budget caps (team/tenant/org), reviews cost reports", "REST API")
Rel(compliance_officer, amir, "Audits events, verifies hash chain, reviews retention policies", "REST API")
Rel(project_manager, amir, "Tracks workflow progress, monitors feature delivery status", "REST API")
Rel(debugger, amir, "Inspects agent sessions, replays failed executions", "REST API")

' ──────────────────────────────────────────────────────────────────
' RELATIONSHIPS — AMIR → EXTERNAL SYSTEMS
' ──────────────────────────────────────────────────────────────────

Rel(amir, git_vcs, "Reads GitOps definitions; clones workspaces; git-native compensation", "Git")
Rel(amir, ci_cd, "Produces PRs for external CI validation", "Webhook")

Rel(amir, llm_providers, "Routes agent LLM calls through egress proxy", "mTLS via egress proxy")
Rel(amir, vault, "Fetches JIT secrets and signing keys for attestation", "Vault API (mTLS)")
Rel(amir, prometheus, "Emits metrics, cost records, scorecards, traces", "Prometheus / OpenTelemetry")
Rel(amir, object_storage, "Stores audit logs (WORM), replay metadata, artifacts", "Object Storage API")
Rel(amir, notification_system, "Delivers EscalationSignals and approval requests", "Webhook")
Rel(amir, registries, "Agent dependency installs and sandbox image pulls via egress proxy (coding_standard + container_build profiles)", "mTLS via egress proxy")
Rel(amir, message_queue, "Publishes domain events via outbox or direct", "Kafka / NATS")
Rel(amir, transparency_log, "Commits audit hash-chain root hashes", "HTTPS")
Rel(amir, idp, "Validates JWT tokens, obtains service identities for mTLS", "OAuth / mTLS")

' ──────────────────────────────────────────────────────────────────
' RELATIONSHIPS — AGENTS → EXTERNAL SYSTEMS (via egress proxy)
' ──────────────────────────────────────────────────────────────────

Rel(amir, agents, "Invokes via AgentAdapter; injects CompiledPrompt + secrets; observes workspace", "Adapter protocol + sandbox")
Rel(agents, llm_providers, "Calls model APIs for inference (all traffic forced through Amir egress proxy)", "HTTPS via egress proxy")
Rel(agents, git_vcs, "Commits code changes, pushes durable effects (when policy permits)", "Git via egress proxy")
Rel(agents, registries, "Pulls package dependencies and sandbox images (only hosts in effective allowlist)", "HTTPS via egress proxy")

' ──────────────────────────────────────────────────────────────────
' NOTES
' ──────────────────────────────────────────────────────────────────

note bottom of agents
  Agents are untrusted external processes.
  All agent outbound traffic is forced through Amir's egress proxy.
  Direct network access is eliminated (host mode removed).
  Effective allowlist = intersection of agent ∩ sandbox ∩ role.
end note

@enduml
