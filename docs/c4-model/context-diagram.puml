@startuml Amir-System-Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Amir System Context Diagram — AI Agent Orchestration Control Plane

' ──────────────────────────────────────────────────────────────────
' ACTORS
' ──────────────────────────────────────────────────────────────────

Person(developer, "Developer", "Creates tasks programmatically via API, monitors execution progress, debugs agent output")
Person(platform_operator, "Platform Operator", "Manages team/agent/workflow definitions, monitors system health, cost, and agent performance")
Person(approver, "Approver / Reviewer", "Grants human approvals (workflow gates, coercion), resolves escalation signals")
Person(agent_owner, "Agent Owner", "Registers and configures agent adapters, declares capabilities and output modes")
Person(security_officer, "Security Officer", "Enforces sandbox policy, network allowlists, secret injection, attestation verification")
Person(financial_controller, "Financial Controller", "Defines budget caps (team/tenant/org), monitors cost tracking and enforcements")
Person(compliance_officer, "Compliance Officer", "Audits linear hash-chained events, verifies tamper-evidence, reviews retention policies")
Person(project_manager, "Project Manager", "Tracks workflow progress, monitors feature delivery and compensation status")
Person(debugger, "On-call / Debugger", "Inspects agent sessions, replays failed executions for debugging")

' ──────────────────────────────────────────────────────────────────
' AMIR SYSTEM
' ──────────────────────────────────────────────────────────────────

System(amir, "Amir Control Plane", "Orchestrates external AI coding agents: task assignment, session management, workspace observation, cost governance, security enforcement, workflow compensation, and contract validation")

' ──────────────────────────────────────────────────────────────────
' EXTERNAL SYSTEMS
' ──────────────────────────────────────────────────────────────────

System_Ext(git_vcs, "Git VCS (GitHub/GitLab)", "Dual-purpose: (1) amir-config/ GitOps definitions (agents, roles, workflows, contracts, allowlists) and (2) source code repos cloned per workspace with durable effects (branches, PRs, commits) as compensation targets")
System_Ext(ci_cd, "CI/CD Pipeline", "Validates workflow artifacts (PRs, code changes); config validation (JSON Schema, DDL); separate system triggered by Amir PRs")
System_Ext(llm_providers, "LLM Providers", "OpenAI, Anthropic, Google, etc. — external API endpoints agents call through Amir's egress proxy for inference")
System_Ext(vault, "HashiCorp Vault / KMS", "Secret storage for JIT injection via SecretBinding with TTL; signing keys for sandbox attestation and linear hash-chain audit root-commit")
System_Ext(prometheus, "Prometheus / OpenTelemetry", "Metrics collection (cost records, agent performance, validation pipeline); distributed tracing via W3C trace context")
System_Ext(object_storage, "Object Storage (WORM)", "Permanent audit log retention (linear hash-chained events), replay metadata, large artifact storage, transparency log root-commits")
System_Ext(notification_system, "Notification System", "Delivers EscalationSignals to assigned recipients (cost_limit_exceeded, compensation_blocked, input_timeout); approval request routing")
System_Ext(pkg_registries, "Package Registries", "PyPI, npm, crates.io, Maven, RubyGems — agent dependency installs via egress proxy (coding_standard allowlist profile)")
System_Ext(container_registries, "Container Registries", "ghcr.io, quay.io — base image pulls for sandbox runtimes (container_build profile only; runtime=docker is structurally illegal in production)")
System_Ext(message_queue, "Message Queue (optional)", "Kafka / NATS — high-throughput domain event publishing (alternative to outbox table)")
System_Ext(transparency_log, "Transparency Log (optional)", "Append-only log (Sigstore/Rekor) for periodic root-commit of audit hash-chain tips")
System_Ext(idp, "Identity Provider", "Issues JWTs / OAuth tokens for API access and service-to-service mTLS authentication")

System_Ext(agents, "External AI Agents", "Claude Code CLI, Codex, OpenCode, Gemini CLI, MCP servers, API agents — heterogeneous, non-deterministic, untrusted")

' ──────────────────────────────────────────────────────────────────
' RELATIONSHIPS — ACTORS → AMIR
' ──────────────────────────────────────────────────────────────────

Rel(developer, amir, "Creates tasks, monitors execution, debugs agent output", "REST API (JWT)")
Rel(platform_operator, amir, "Manage definitions, monitor metrics/cost/health, configure teams", "REST API / Dashboard")
Rel(approver, amir, "Grant approvals (workflow gates, coercion), resolve escalation signals", "REST API / Notifications")
Rel(agent_owner, amir, "Register agent adapters, declare capabilities, configure output modes", "REST API")
Rel(security_officer, amir, "Define sandbox policies, network allowlists, secret bindings, attestation rules", "REST API / Config")
Rel(financial_controller, amir, "Define budget caps (team/tenant/org), review cost reports", "REST API / Dashboard")
Rel(compliance_officer, amir, "Audit events, verify hash chain, review retention policies", "API / Object Storage")
Rel(project_manager, amir, "Track workflow progress, monitor feature delivery status", "REST API / Dashboard")
Rel(debugger, amir, "Inspect agent sessions, replay failed executions", "REST API / Dashboard")

' ──────────────────────────────────────────────────────────────────
' RELATIONSHIPS — AMIR → EXTERNAL SYSTEMS
' ──────────────────────────────────────────────────────────────────

Rel(amir, git_vcs, "Reads GitOps definitions; clones per workspace, observes workspace state (git diff/status), auto-commit, git-native compensation (revert/branch-delete/PR-close)", "Git (clone, diff, commit, push)")
Rel(amir, ci_cd, "Produced PRs validated by external CI; config files validated against schemas", "PR creation / webhook")

Rel(amir, llm_providers, "Agent LLM calls routed through egress proxy (mandatory; host mode eliminated)", "mTLS via egress proxy")
Rel(amir, vault, "Fetch secrets (JIT, TTL), inject via SecretBinding (tmpfs/proxy/env); fetch signing keys for attestation", "Vault API (mTLS)")
Rel(amir, prometheus, "Emits metrics, cost records, agent scorecard updates, validation metrics, traces", "Prometheus / OpenTelemetry")
Rel(amir, object_storage, "Store permanent audit logs (WORM), replay metadata, large artifacts, transparency log root-commits", "Object Storage API")
Rel(amir, notification_system, "Delivers EscalationSignals (cost_limit_exceeded, compensation_blocked, input_timeout), approval requests to assigned recipients", "Webhook / API")
Rel(amir, pkg_registries, "Agent dependency installs routed through egress proxy (coding_standard allowlist profile)", "mTLS via egress proxy")
Rel(amir, container_registries, "Sandbox base image pulls routed through egress proxy (container_build profile only)", "mTLS via egress proxy")
Rel(amir, message_queue, "Publishes domain events via outbox table (primary) or direct to queue (alternative)", "Kafka / NATS / Outbox")
Rel(amir, transparency_log, "Commits audit hash-chain root hashes for tamper-evidence anchoring", "HTTPS")
Rel(amir, idp, "Validates JWT tokens, obtains service identities for mTLS", "OAuth / mTLS")

' ──────────────────────────────────────────────────────────────────
' RELATIONSHIPS — AGENTS → EXTERNAL SYSTEMS (via egress proxy)
' ──────────────────────────────────────────────────────────────────

Rel(amir, agents, "Invokes via AgentAdapter (start, pump, cancel); injects CompiledPrompt + secrets; observes workspace as ground truth", "Adapter protocol + sandbox")

' ──────────────────────────────────────────────────────────────────
' NOTES
' ──────────────────────────────────────────────────────────────────

note right of amir
  **P1 Architectural Invariants**
  • Workspace > agent claims (ground truth)
  • Fail-closed cost (CostLease revoked = sole kill signal)
  • Fail-closed parser (workspace_observation unavailable = reject)
  • lease_revision increments by exactly +1 per mutation
  • Production runtime in {gVisor, Firecracker} only
  • Allowlist merge = intersection only
  • validation_budget required and partitioned
  • All mutable operations require idempotency keys
end note

note bottom of agents
  Agents are **untrusted external processes**.
  **All agent outbound traffic** (LLM inference, Git push,
  package install) is **forced through Amir's egress proxy**.
  Direct network access is eliminated (host mode removed).
  Effective allowlist = intersection of agent ∩ sandbox ∩ role.
  Amir treats agent stdout as narrative; all artifacts derived
  from Workspace observation (git diff/status) + claim reconciliation.
  llm_coercion requires explicit human Approval.
end note

@enduml
