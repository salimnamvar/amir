@startuml C4_Context
!include <C4/C4_Context>

' Title
title System Context Diagram - Amir AI Agent Orchestration Platform

' Layout
LAYOUT_WITH_LEGEND()

' ============================================
' People (Actors)
' ============================================
Person(platform_admin, "Platform Administrator", "Configures teams, roles, agents, security policies, and budgets via GitOps PRs")
Person(developer, "Developer / User", "Submits tasks and workflows for AI agent execution via API")
Person(oncall, "On-Call Engineer", "Responds to escalation signals, grants approvals, handles incidents")

' ============================================
' Amir System (In Scope)
' ============================================
System(amir, "Amir Control Plane", "Orchestrates external AI agents with engineering-grade governance, cost control, and security isolation")

' ============================================
' External Systems (Out of Scope)
' ============================================
System_Ext(git_config, "Configuration Repository", "GitOps-managed definitions (amir-config): teams, roles, agents, workflows, skills, prompts")
System_Ext(git_repos, "Source Code Repositories", "Code repositories where agents produce changes via branches, commits, PRs")
System_Ext(llm_providers, "LLM Providers", "Anthropic, OpenAI, Google, etc. - AI model APIs for agent execution")
System_Ext(vault, "Secrets Manager", "HashiCorp Vault - JIT secret injection with TTL and auto-revocation")
SystemDb_Ext(kms, "KMS / HSM", "Platform signing keys for sandbox attestation and audit chain verification")
SystemDb_Ext(prometheus, "Prometheus", "Time-series metrics collection for cost, performance, and operational monitoring")
SystemDb_Ext(object_storage, "Object Storage", "Long-term audit logs, replay data, WORM storage for tamper-evidence")
System_Ext(transparency_log, "Transparency Log", "External tamper-evidence root commits for audit chain verification")

' ============================================
' Relationships
' ============================================

' People -> Amir
Rel(platform_admin, amir, "Configures policies, monitors health", "HTTPS/API")
Rel(developer, amir, "Submits tasks/workflows", "HTTPS/API")
Rel(oncall, amir, "Responds to escalations, grants approvals", "HTTPS/API")

' People -> External Systems
Rel(platform_admin, git_config, "Manages definitions via PRs", "Git")

' Amir -> External Systems
Rel(amir, git_config, "Reads definitions (GitOps)", "Git clone/pull")
Rel(amir, git_repos, "Creates branches, commits, PRs (compensation)", "Git/HTTPS")
Rel(amir, llm_providers, "Routes API calls via egress proxy", "mTLS/HTTPS")
Rel(amir, vault, "Fetches secrets, creates bindings with TTL", "API/mTLS")
Rel(amir, kms, "Signs attestations, verifies audit chain", "API")
Rel(amir, prometheus, "Emits metrics", "Remote Write")
Rel(amir, object_storage, "Stores audit logs, replay data", "S3 API")
Rel(amir, transparency_log, "Commits root hashes for tamper-evidence", "API")

